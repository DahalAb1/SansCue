# Default deny: only source types and explicit build configuration enter context.
# Add future asset/input types deliberately; never reinclude whole application trees.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!services/
!services/sessions/
!services/sessions/Cargo.toml
!services/sessions/src/
!services/sessions/src/**/
!services/sessions/src/**/*.rs
!services/sessions/migrations/
!services/sessions/migrations/**/*.sql
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**/
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
!deploy/
!deploy/Caddyfile
# Defense in depth for sensitive directories even if they contain source-like files.
**/.env
**/.env.*
**/.aws
**/.ssh
**/.gnupg
**/.netrc
**/.npmrc
**/.pypirc
**/node_modules
**/dist
**/target
**/build
**/coverage
**/.git
**/*.log
**/local-data
**/secrets
**/credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
