# Copy to private local-data/bee-remote.env on the authenticated Mac, mode 600.
# These values must match EC2. Do not copy operator, model or other DB credentials.
BEE_POSTGRES_USER=bee_app
BEE_POSTGRES_DB=bee
BEE_POSTGRES_PASSWORD=
SESSIONS_BEE_SERVICE_TOKEN=
TOPICS_BEE_SERVICE_TOKEN=
# Optional absolute executable path when bee is not on PATH.
# BEE_CLI_PATH=/path/to/bee
