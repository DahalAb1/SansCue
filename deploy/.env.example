# LOCAL DEVELOPMENT ONLY: this sample password is not production-ready.
# Keep the canonical database and local role names unchanged.
POSTGRES_DB=sessions
POSTGRES_USER=sessions_app
# Use only URL-unreserved characters: A-Z a-z 0-9 . _ ~ -
# DATABASE_URL interpolates this value directly; do not use URL punctuation.
POSTGRES_PASSWORD=sanscue-local-only-change-me

# Operator access (required to create rooms). Leave blank to start the stack with
# operator access disabled; the service then rejects operator login (fail closed).
# All three must be set together, otherwise the operator stays disabled. Never place
# the plaintext operator credential in this file, Git, images, shell history, or logs.
# See "Operator provisioning" in deploy/README.md for generation commands.
# SHA-256 hex (64 chars) of a random 256-bit operator credential:
SESSIONS_OPERATOR_TOKEN_SHA256=
# Non-secret epoch label (letters, digits, . _ -). Change it to revoke operator sessions:
SESSIONS_OPERATOR_EPOCH=
# Independent random 256-bit key as 64 hex chars; never reuse the credential or its hash:
SESSIONS_IDEMPOTENCY_HMAC_KEY=
