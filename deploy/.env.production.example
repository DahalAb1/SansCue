# Copy to deploy/.env in a separate EC2 checkout. Never reuse local-demo secrets.
# Public IPv4 address now, or a bare domain later: no scheme, slash or port.
SANSCUE_DOMAIN=

# Hackathon demo: judges can create rooms immediately. Set false to disable.
SESSIONS_DEMO_OPEN_ROOMS=true

POSTGRES_DB=sessions
POSTGRES_USER=sessions_app
POSTGRES_PASSWORD=
BEE_POSTGRES_DB=bee
BEE_POSTGRES_USER=bee_app
BEE_POSTGRES_PASSWORD=
TOPICS_POSTGRES_DB=topics
TOPICS_POSTGRES_USER=topics_app
TOPICS_POSTGRES_PASSWORD=
# Separate PostgreSQL bootstrap credentials; never sent to application services.
SESSIONS_DB_BOOTSTRAP_PASSWORD=
BEE_DB_BOOTSTRAP_PASSWORD=
TOPICS_DB_BOOTSTRAP_PASSWORD=

# Independent random values, at least 32 bytes each; hex works for all fields.
SESSIONS_BEE_SERVICE_TOKEN=
SESSIONS_TOPICS_SERVICE_TOKEN=
TOPICS_BEE_SERVICE_TOKEN=
TOPICS_SESSIONS_SERVICE_TOKEN=

# Filled by python3 deploy/provision_operator.py; credential stays outside this file.
SESSIONS_OPERATOR_TOKEN_SHA256=
SESSIONS_OPERATOR_EPOCH=
SESSIONS_IDEMPOTENCY_HMAC_KEY=

# Configure at most one provider. Empty means explicit placeholder generation.
ANTHROPIC_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
TOPICS_BEDROCK_CREDENTIALS_FILE=
AWS_REGION=us-east-1
TOPICS_MODEL=
