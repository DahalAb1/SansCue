{
	admin off
	email {$ACME_EMAIL}
}

{$SANSCUE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Access logs are deliberately disabled: invite URLs contain credentials.
	route {
		@sessions path /api/sessions /api/sessions/*
		handle @sessions {
			uri strip_prefix /api/sessions
			reverse_proxy sessions:3000
		}
		@api path /api /api/*
		handle @api {
			respond "Not found" 404
		}
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}

# Container-local static health probe; never published on the host.
http://127.0.0.1:8081 {
	root * /srv
	rewrite /healthz /index.html
	file_server
}
