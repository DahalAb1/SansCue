# Supply these explicitly through the process environment; Rust does not load this file.
# Local development only. Compose uses sessions-db and HTTP_HOST=0.0.0.0.
DATABASE_URL=postgres://sessions_app:local-development-only@127.0.0.1:5432/sessions
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
RUST_LOG=info

# From the repository root, after provisioning PostgreSQL 17 and exporting settings:
# cargo run --locked -p sessions-service
# cargo fmt --all -- --check
# cargo clippy --workspace --all-targets -- -D warnings
# DATABASE_URL=<disposable PostgreSQL 17 URL> cargo test --workspace
# Tests require a dedicated, disposable database owned by the configured role.
# They apply the bootstrap migration; missing DATABASE_URL fails rather than skips.
# Startup connection + migrations share a 15-second total timeout before binding.
# Configuration, initialization, migration or bind failure exits nonzero.
# Readiness has a 2-second total timeout; pool max=5, acquire timeout=5 seconds.
